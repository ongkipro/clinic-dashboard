{
  "name": "clinic-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "docs:check": "python3 scripts/check-traceability.py docs/spec --tasks TASKS.md",
    "docs:promotion": "for f in README.md AGENTS.md PRD.md TASKS.md PLAN.md STATUS.md DECISIONS.md ARCHITECTURE.md BUILD-LOG.md RELEASE.md OBSERVABILITY.md DESIGN.md design/brief.md; do test -s \"$f\" || { echo \"missing or empty: $f\"; exit 1; }; done; test -d .delivery || { echo 'missing: .delivery/'; exit 1; }; echo 'PASS promotion documents'",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/db/migrate.ts",
    "db:migrate:local": "DB_LOCAL=1 pnpm db:migrate",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:rls": "vitest run tests/rls",
    "test:isolation": "vitest run tests/isolation",
    "test:auth": "vitest run tests/auth",
    "test:org": "vitest run tests/org",
    "test:audit": "vitest run tests/audit",
    "test:readers": "vitest run tests/rls/readers.test.ts",
    "test:idempotency": "vitest run tests/idempotency"
  },
  "dependencies": {
    "better-auth": "1.7.15",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.65.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "26.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
