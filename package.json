{
  "name": "clinic-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "docs:check": "python3 scripts/check-traceability.py docs/spec --tasks TASKS.md",
    "docs:promotion": "for f in README.md AGENTS.md PRD.md TASKS.md PLAN.md STATUS.md DECISIONS.md ARCHITECTURE.md BUILD-LOG.md RELEASE.md OBSERVABILITY.md DESIGN.md design/brief.md; do test -s \"$f\" || { echo \"missing or empty: $f\"; exit 1; }; done; test -d .delivery || { echo 'missing: .delivery/'; exit 1; }; echo 'PASS promotion documents'"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "26.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
